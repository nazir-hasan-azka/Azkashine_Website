# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code personal settings (do not commit)
.claude/settings.local.json

# design source — Figma exports + working/extracted images (not used at runtime;
# the finished icons the app serves live in /public). Kept local, not in git.
/assets

# Reference material — NOT for git. The GitHub repo is public, and this folder holds
# the corporate portfolio deck (42MB) and its extracted text. Publishing an internal
# sales deck to the open internet is not undoable once it is in history.
/.claude/references
